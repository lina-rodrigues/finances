# API
PORT=4000
MONGODB_URI=mongodb://localhost:27017/finance
CORS_ORIGIN=http://localhost:3000

# API — Auth
JWT_SECRET=change-me-in-production
INVITATION_CODE=dev-invite-code
FRONTEND_URL=http://localhost:3000

# API — Email (Mailpit defaults for dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=finance@localhost

# API — AI reports (Cursor SDK; server-only)
CURSOR_API_KEY=
# AI_REPORT_PROMPT_PATH=prompts/financial-health-report.txt
# REPORT_TIMEZONE=America/Sao_Paulo

# Frontend — browser calls /api (Next.js rewrite); server calls API_URL directly
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Deploy script (pnpm deploy). Copy the real values into .env; leave these empty.
VERCEL_TEAM_ID=
VERCEL_FRONTEND_PROJECT_ID=
VERCEL_FRONTEND_URL=
VERCEL_API_PROJECT_ID=
VERCEL_API_URL=
